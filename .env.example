# ==========================================
# Olive's 30th Birthday Photo Memory Vault
# Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Private Family Gallery Access PIN (Change this to whatever Olive and family want)
FAMILY_PIN=3030

# Maximum Total Storage Limit in Megabytes (5000 MB = ~5 GB)
MAX_STORAGE_MB=5000

# Storage Provider: "local" (for offline/local testing) or "s3" (for AWS S3)
STORAGE_MODE=local

# ------------------------------------------
# AWS S3 Settings (Required when STORAGE_MODE=s3)
# ------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=olives-30th-birthday-vault
